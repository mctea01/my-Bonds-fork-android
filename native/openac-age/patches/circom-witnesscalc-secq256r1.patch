diff --git a/src/field.rs b/src/field.rs
index 3abef98..ab4631b 100644
--- a/src/field.rs
+++ b/src/field.rs
@@ -318,6 +318,54 @@ impl FieldOps for U254 {
     // }
 }
 
+// Full 256-bit width for primes such as secq256r1 that do not fit in U254.
+impl FieldOps for U256 {
+
+    const BITS: usize = 256;
+    const BYTES: usize = 32;
+    const MAX: U256 = U256::MAX;
+
+    fn from_str(v: &str) -> Result<Self, Box<dyn std::error::Error>> {
+        U256::from_str_radix(v, 10).map_err(|e| e.into())
+    }
+
+    fn from_le_bytes(v: &[u8]) -> Result<Self, Box<dyn std::error::Error + Sync + Send>> {
+        U256::try_from_le_slice(v).ok_or_else(|| anyhow!("invalid le bytes").into())
+    }
+
+    fn to_le_bytes(&self) -> Vec<u8> {
+        self.to_le_bytes_vec()
+    }
+
+    #[inline]
+    fn add_mod(self, rhs: Self, m: Self) -> Self {
+        <U256>::add_mod(self, rhs, m)
+    }
+
+    #[inline]
+    fn mul_mod(self, rhs: Self, m: Self) -> Self {
+        <U256>::mul_mod(self, rhs, m)
+    }
+
+    #[inline]
+    fn inv_mod(self, m: Self) -> Self {
+        <U256>::inv_mod(self, m).unwrap()
+    }
+
+    #[inline]
+    fn pow_mod(self, exp: Self, m: Self) -> Self {
+        <U256>::pow_mod(self, exp, m)
+    }
+
+    fn bit_len(self) -> usize {
+        <U256>::bit_len(&self)
+    }
+
+    fn from_bool(value: bool) -> Self {
+        if value { Self::one() } else { Self::zero() }
+    }
+}
+
 pub trait FieldOps: Sized + Copy + Zero + One + PartialEq + Sub<Output = Self>
     + Shr<usize, Output = Self> + Shl<usize, Output = Self> + Rem<Output = Self>
     + BitAnd<Output = Self> + BitOr<Output = Self> + BitXor<Output = Self>
