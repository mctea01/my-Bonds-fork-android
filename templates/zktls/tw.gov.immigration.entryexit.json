{
  "id": "tw.gov.immigration.entryexit/1",
  "title": "移民署入出國日期證明書驗證",
  "host": "ncp.immigration.gov.tw",
  "official": true,
  "prepare": {
    "type": "captcha",
    "page": "/NIA_OnlineApply_inter/entryexitQueryNew/entryexitQueryForm.action",
    "image": "/NIA_OnlineApply_inter/jcaptcha",
    "input": "captcha",
    "cookies": [
      "JSESSIONID"
    ]
  },
  "request": {
    "method": "POST",
    "path": "/NIA_OnlineApply_inter/entryexitQueryNew/entryexitQueryResult.action",
    "body": "entryExitQueryNewDTO.checkNo={checkNo}&entryExitQueryNewDTO.serialNo={serialNo}&jcaptchaResponse={captcha}",
    "headers": {
      "User-Agent": "Mozilla/5.0"
    },
    "inputs": [
      {
        "name": "checkNo",
        "label": "身分證字號／統一證號／護照號碼",
        "pattern": "^[A-Za-z0-9]{6,20}$",
        "private": true
      },
      {
        "name": "serialNo",
        "label": "證明書序號",
        "pattern": "^[0-9]{8,20}$",
        "private": true
      },
      {
        "name": "captcha",
        "label": "驗證碼（不分大小寫）",
        "pattern": "^[A-Za-z0-9]{4,8}$",
        "private": true
      }
    ]
  },
  "limits": {
    "maxSent": 2048,
    "maxRecv": 65536
  },
  "status": {
    "reveal": "<h2>\\s*[^<\\s][^<]{0,60}</h2>",
    "success": "^<h2>\\s*入出國日期證明書驗證結果\\s*</h2>$"
  },
  "fields": [
    {
      "name": "issued",
      "label": "發證日期",
      "reveal": "<span>發證日期 : </span>\\s*([0-9]{4}/[0-9]{2}/[0-9]{2})<br>"
    },
    {
      "name": "name",
      "label": "姓名",
      "reveal": "<span>姓名 : </span>\\s*([^<]{1,40})<br>"
    },
    {
      "name": "nameEn",
      "label": "英文姓名",
      "reveal": "<span>Name:</span>\\s*([^<]{1,80})</div>"
    },
    {
      "name": "nationality",
      "label": "國籍",
      "reveal": "<span>國籍 : </span>\\s*([^<]{1,40})<br>"
    },
    {
      "name": "gender",
      "label": "性別",
      "reveal": "<span>姓別 : </span>\\s*([^<]{1,10})<br>"
    },
    {
      "name": "birthDate",
      "label": "出生日期",
      "reveal": "<span>出生日期 \\(年/月/日\\) : </span>\\s*([0-9]{4}/[0-9]{2}/[0-9]{2})<br>"
    },
    {
      "name": "latestExit",
      "label": "最近一次出境日期",
      "reveal": "<tr>\\s*<td>1</td>\\s*<td></td>\\s*<td>(?:[0-9]{4}/[0-9]{2}/[0-9]{2}|-{10})</td>\\s*<td></td>\\s*<td>([0-9]{4}/[0-9]{2}/[0-9]{2}|-{10})</td>"
    },
    {
      "name": "latestEntry",
      "label": "最近一次出境後的入境日期（---------- 表示尚未入境）",
      "reveal": "<tr>\\s*<td>1</td>\\s*<td></td>\\s*<td>([0-9]{4}/[0-9]{2}/[0-9]{2}|-{10})</td>"
    }
  ]
}
