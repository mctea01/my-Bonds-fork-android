{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Taipei",
  "labels": [
    "dependencies"
  ],
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "rebaseWhen": "auto",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Minor, patch and digest updates merge by themselves once CI passes",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Major updates wait for approval on the Dependency Dashboard",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Multipaz and Ktor move together; the wallet carries workarounds for Multipaz",
      "groupName": "multipaz and ktor",
      "matchPackageNames": [
        "org.multipaz:**",
        "io.ktor:**"
      ],
      "automerge": false
    },
    {
      "description": "Toolchain: Kotlin, Compose Multiplatform and the Android Gradle plugin",
      "matchPackageNames": [
        "org.jetbrains.kotlin.**",
        "org.jetbrains.compose",
        "org.jetbrains.compose.**",
        "com.android.application",
        "com.android.library",
        "com.android.tools.**"
      ],
      "automerge": false
    },
    {
      "description": "Credential Manager and DC API need a device check, CI does not cover them",
      "matchPackageNames": [
        "androidx.credentials:**",
        "androidx.credentials.registry:**",
        "com.google.android.gms:play-services-identity-credentials"
      ],
      "automerge": false,
      "groupName": "credential manager and dc api"
    },
    {
      "description": "OkHttp 5.5 needs compileSdk 37; held at 5.4 until AGP 9 and compileSdk 37 (see app/build.gradle.kts)",
      "matchPackageNames": [
        "com.squareup.okhttp3:**"
      ],
      "allowedVersions": "<5.5.0"
    },
    {
      "description": "xml-apis 2.0.2 is an old relocation artifact, not a newer release",
      "matchPackageNames": [
        "xml-apis:xml-apis"
      ],
      "enabled": false
    }
  ]
}
