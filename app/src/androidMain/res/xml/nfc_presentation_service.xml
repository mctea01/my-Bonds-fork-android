<?xml version="1.0" encoding="utf-8"?>
<!--
  ISO/IEC 18013-5 proximity presentation. The wallet only answers while its "感應出示" screen is open and the phone
  is unlocked; the user confirms every request on that screen.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/nfc_presentation_service"
    android:requireDeviceUnlock="true">

    <aid-group android:description="@string/nfc_engagement_aid_group" android:category="other">
        <!-- NFC Forum Type 4 Tag NDEF application, used for mdoc NFC engagement (ISO/IEC 18013-5 clause 8.2.2.1). -->
        <aid-filter android:name="D2760000850101" />
    </aid-group>

    <aid-group android:description="@string/nfc_data_transfer_aid_group" android:category="other">
        <!-- mdoc NFC data transfer (ISO/IEC 18013-5 clause 8.3.3.1.2). -->
        <aid-filter android:name="A0000002480400" />
    </aid-group>
</host-apdu-service>
