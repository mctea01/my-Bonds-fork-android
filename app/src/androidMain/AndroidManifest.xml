<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- Bonds BLE link: the wallet advertises the verifier's one-time service as a GATT peripheral. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- ISO/IEC 18013-5 proximity presentation: the wallet scans for the reader in BLE central client mode. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Opening the mobile citizen certificate app (mobilemoica:) from a source site. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mobilemoica" />
        </intent>
    </queries>
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
    <!-- USB CCID contactless readers attached by OTG, for in-person verification. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".android.WalletApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openid4vp" />
                <data android:scheme="haip-vp" />
                <data android:scheme="eudi-openid4vp" />
                <data android:scheme="mdoc-openid4vp" />
                <data android:scheme="openid-credential-offer" />
                <data android:scheme="haip-vci" />
                <data android:scheme="openid" />
                <data android:scheme="siopv2" />
            </intent-filter>
            <intent-filter>
                <!-- TWDIW deep links (credential_offer, authorize, staticqrcode). -->
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="modadigitalwallet" />
            </intent-filter>
            <intent-filter>
                <!-- Microsoft Entra Verified ID requests and the sign-in redirect of its contracts. -->
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openid-vc" />
                <data android:scheme="vcclient" />
            </intent-filter>
            <intent-filter>
                <!-- Documents opened with or shared to the wallet are stored in the document vault. -->
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/pkcs7-signature" />
                <data android:mimeType="application/pkcs7-mime" />
                <data android:mimeType="application/x-pkcs7-signature" />
                <data android:mimeType="application/x-pkcs7-mime" />
                <data android:mimeType="application/timestamp-reply" />
                <data android:mimeType="application/vnd.etsi.asic-e+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/ofd" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="diw-wallet" android:host="oid4vci" android:path="/callback" />
            </intent-filter>
            <intent-filter>
                <!-- Return from the mobile citizen certificate app after an app-to-app signature. -->
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="diw-wallet" android:host="moica" android:path="/return" />
            </intent-filter>
            <intent-filter>
                <!-- Authorization code from a remote signing service (CSC API): the EUDI QTSP's registered address and the wallet's own. -->
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rqes" android:host="oauth" android:path="/callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="diw-wallet" android:host="csc" android:path="/callback" />
            </intent-filter>
        </activity>

        <service
            android:name=".android.WalletNfcService"
            android:exported="true"
            android:label="@string/nfc_presentation_service"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/nfc_presentation_service" />
        </service>

        <activity
            android:name=".android.DcApiActivity"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="androidx.credentials.registry.provider.action.GET_CREDENTIAL" />
                <action android:name="androidx.identitycredentials.action.GET_CREDENTIALS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
